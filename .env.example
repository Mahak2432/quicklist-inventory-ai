# Copy this file to .env and fill in only what you need. Never commit .env.
# Every value here is optional except MASTER_KEY, which is required to save any
# marketplace or store credentials.

# --- Server ---
PORT=3000
DB_PATH=./data/quicklist-inventory-ai.db
UPLOAD_DIR=./data/uploads
# Public address of this app, used for marketplace image links. Example: https://quicklist-inventory-ai.example.com
PUBLIC_BASE_URL=

# --- Secrets (generate each with the command in README.md) ---
# 32 random bytes, base64. Encrypts seller credentials at rest.
MASTER_KEY=
# Signs public image links. Generate it the same way as MASTER_KEY.
MEDIA_SECRET=

# --- Meta Model API (photo reading, studio photos, reply parsing) ---
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_SPARK_MODEL=muse-spark-1.1
META_IMAGE_MODEL=muse-image-1.0
# Set to off to skip Muse Image and use the local cleanup only.
META_IMAGE_EDIT=

# --- WhatsApp Cloud API (your business test number) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- Developer options ---
# Lets connectors reach private addresses. Use only on your own computer for testing.
ALLOW_PRIVATE_URLS=0
SHOPIFY_API_VERSION=2025-01
